<UserControl x:Class="AstraFinance.App.Views.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:svc="clr-namespace:AstraFinance.App.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:CalendarViewModel}">
    <!--
        Premium Financial Calendar (read-only): month grid with income/expense markers, today highlight,
        and the selected day's totals and transactions.
    -->
    <UserControl.Resources>
        <Style x:Key="Marker" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- One day cell -->
        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10" Padding="8,6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmountText" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The page scrolls, so the month grid keeps its natural height at any window size. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid x:Name="Root" Margin="{DynamicResource Padding.Page.Current}" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Month navigation + month totals -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Border Style="{StaticResource Toolbar}" Padding="4" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronLeft" Command="{Binding PreviousMonthCommand}"
                            ToolTip="{loc:Loc Calendar.PrevMonth}" AutomationProperties.Name="{loc:Loc Calendar.PrevMonth}" />
                    <c:AstraIcon Data="{StaticResource Icon.Calendar}" Width="16" Height="16" Margin="8,0" Foreground="{DynamicResource Brush.Accent.Text}" />
                    <TextBlock Text="{Binding MonthText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" MinWidth="140" />
                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronRight" Command="{Binding NextMonthCommand}"
                            ToolTip="{loc:Loc Calendar.NextMonth}" AutomationProperties.Name="{loc:Loc Calendar.NextMonth}" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Calendar.Today}" Command="{Binding TodayCommand}" Margin="0,0,24,8"
                    VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,8">
                <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Success}" />
                <TextBlock Text="{loc:Loc Calendar.MonthIncome}" Style="{StaticResource Text.Caption}" Margin="2,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MonthIncomeText}" Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.Success}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,8">
                <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Danger}" />
                <TextBlock Text="{loc:Loc Calendar.MonthExpense}" Style="{StaticResource Text.Caption}" Margin="2,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MonthExpenseText}" Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="{loc:Loc Calendar.Net}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MonthNetText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonthNetNegative}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </WrapPanel>

        <!-- Month grid -->
        <Border x:Name="CalendarCard" Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekdayHeaders}" Focusable="False" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Overline}" HorizontalAlignment="Center" Margin="0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Legend -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,8,0,2">
                    <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Success}" />
                    <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                    <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="{loc:Loc TransactionType.Expense}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                    <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Info}" />
                    <TextBlock Text="{loc:Loc TransactionType.Transfer}" Style="{StaticResource Text.Caption}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Days}" Focusable="False" KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="{Binding MonthText}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:CalendarDayViewModel}">
                            <Button x:Name="Cell" Style="{StaticResource DayCell}" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}"
                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid HorizontalAlignment="Left" Width="28" Height="28">
                                        <Ellipse x:Name="TodayRing" Fill="{DynamicResource Brush.Accent.Gradient}" Visibility="Collapsed" />
                                        <TextBlock x:Name="Number" Text="{Binding DayNumber}" Style="{StaticResource Text.BodyStrong}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,6,0,2">
                                        <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Success}"
                                                 Visibility="{Binding HasIncome, Converter={StaticResource BoolToVisibility}}" />
                                        <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Danger}"
                                                 Visibility="{Binding HasExpense, Converter={StaticResource BoolToVisibility}}" />
                                        <Ellipse Style="{StaticResource Marker}" Fill="{DynamicResource Brush.Info}"
                                                 Visibility="{Binding HasOnlyTransfers, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="TodayRing" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Selected day -->
        <Border x:Name="DetailsCard" Grid.Row="2" Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}"
                AutomationProperties.Name="{Binding SelectedDayTitle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:Loc Calendar.SelectedDay}" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{Binding SelectedDayTitle}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding SelectedIncomeText}" Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc TransactionType.Expense}" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding SelectedExpenseText}" Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,4,0,8" />
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc Calendar.Net}" Style="{StaticResource Text.BodyStrong}" />
                        <TextBlock Text="{Binding SelectedNetText}" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedNetNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{loc:Loc Calendar.DayTransactions}" Style="{StaticResource Text.Overline}" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:Loc Calendar.Day.Empty}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding HasNoSelectedRows, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding SelectedRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.OpenTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Tile" Style="{StaticResource IconTile.Danger}" Width="32" Height="32" CornerRadius="9">
                                            <c:AstraIcon IconKey="{Binding IconKey}" Width="15" Height="15" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" />
                                            <TextBlock Text="{Binding AccountText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource AmountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                        <Setter TargetName="Tile" Property="Style" Value="{StaticResource IconTile.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                                        <Setter TargetName="Tile" Property="Style" Value="{StaticResource IconTile.Info}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Control Grid.Row="3" Style="{StaticResource Spinner}" HorizontalAlignment="Left" Margin="4,8,0,0"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    </ScrollViewer>
</UserControl>
