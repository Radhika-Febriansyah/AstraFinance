<UserControl x:Class="AstraFinance.App.Views.Pages.BudgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:BudgetsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource Padding.Page.Current}" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{loc:Loc Budgets.Intro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Budgets.Add.Title}" Command="{Binding AddCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Month selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource Toolbar}" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronLeft" Command="{Binding PreviousMonthCommand}"
                                ToolTip="{loc:Loc Budgets.PrevMonth}" AutomationProperties.Name="{loc:Loc Budgets.PrevMonth}" />
                        <c:AstraIcon Data="{StaticResource Icon.Calendar}" Width="16" Height="16" Margin="8,0,8,0" Foreground="{DynamicResource Brush.Accent.Text}" />
                        <TextBlock Text="{Binding MonthText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" MinWidth="140" />
                        <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronRight" Command="{Binding NextMonthCommand}"
                                ToolTip="{loc:Loc Budgets.NextMonth}" AutomationProperties.Name="{loc:Loc Budgets.NextMonth}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Budgets.ThisMonth}" Command="{Binding ThisMonthCommand}" Margin="16,0,0,0"
                        Visibility="{Binding IsCurrentMonth, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>

            <!-- Totals -->
            <Border Style="{StaticResource Card.Hero}" Margin="0,0,0,20" Padding="24,20" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconTile.OnHero}">
                                <c:AstraIcon Data="{StaticResource Icon.Budgets}" Style="{StaticResource IconTile.Icon}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Budgets.TotalSpent}" Style="{StaticResource Text.OnHero.Secondary}" FontSize="{StaticResource FontSize.Caption}" />
                                <TextBlock Style="{StaticResource Text.OnHero}" FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0">
                                    <Run Text="{Binding TotalSpentText, Mode=OneWay}" /><Run Text=" / " Foreground="{DynamicResource Brush.Hero.Text.Secondary}" /><Run Text="{Binding TotalLimitText, Mode=OneWay}" Foreground="{DynamicResource Brush.Hero.Text.Secondary}" FontSize="18" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRemainingText}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.OnHero}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalOver}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.OnBrand.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Value="{Binding TotalBarPercent, Mode=OneWay}" Maximum="100" Margin="0,16,0,10"
                                 Background="#33FFFFFF" Foreground="{DynamicResource Brush.Hero.Text}" />
                    <TextBlock Text="{Binding DefaultThresholdText}" Style="{StaticResource Text.OnHero.Secondary}" FontSize="{StaticResource FontSize.Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <c:AstraIcon Data="{StaticResource Icon.Budgets}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{loc:Loc Budgets.Empty.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Budgets.Empty.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                    <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Budgets.Add.Title}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Budgets -->
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:BudgetRowViewModel}">
                        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,16,16" Padding="20,18,20,12">
                            <StackPanel>
                                <!-- Category + status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40">
                                        <Border CornerRadius="11" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Opacity="0.16" />
                                        <c:AstraIcon IconKey="{Binding IconKey}" Width="20" Height="20" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" />
                                        <Border x:Name="StatusBadge" Style="{StaticResource Badge.Info}" Margin="0,4,0,0">
                                            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Style="{StaticResource Badge.Info.Text}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="Percent" Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Text.Title}" FontSize="18"
                                               VerticalAlignment="Top" Foreground="{DynamicResource Brush.Info}" />
                                </Grid>

                                <!-- Spent / limit -->
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,16,0,0">
                                    <Run Text="{Binding SpentText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="20" /><Run Text="  /  " /><Run Text="{Binding LimitText, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar x:Name="Bar" Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,8"
                                             Foreground="{DynamicResource Brush.Info}" />
                                <StackPanel Orientation="Horizontal">
                                    <c:AstraIcon x:Name="AlertIcon" Data="{StaticResource Icon.AlertTriangle}" Width="14" Height="14" Margin="0,0,6,0"
                                                 Visibility="Collapsed" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Remaining" Text="{Binding RemainingText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Actions -->
                                <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,14,0,6" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Button.Icon}" Width="32" Height="32" c:Assist.Icon="Icon.Transactions" ToolTip="{loc:Loc Budgets.ShowExpenses}"
                                            AutomationProperties.Name="{loc:Loc Budgets.ShowExpenses}"
                                            Command="{Binding DataContext.OpenTransactionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Width="32" Height="32" Margin="4,0,0,0" c:Assist.Icon="Icon.Pencil" ToolTip="{loc:Loc Budgets.Edit.Title}"
                                            AutomationProperties.Name="{loc:Loc Budgets.Edit.Title}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Width="32" Height="32" Margin="4,0,0,0" c:Assist.Icon="Icon.Trash" ToolTip="{loc:Loc Budgets.Delete.Title}"
                                            AutomationProperties.Name="{loc:Loc Budgets.Delete.Title}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Normal = blue, approaching the limit = amber, exceeded = red -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="AlertIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="AlertIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="Remaining" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Exceeded">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="AlertIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="AlertIcon" Property="Data" Value="{StaticResource Icon.AlertCircle}" />
                                <Setter TargetName="AlertIcon" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="Remaining" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
