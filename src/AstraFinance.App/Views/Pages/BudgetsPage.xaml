<UserControl x:Class="AstraFinance.App.Views.Pages.BudgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:BudgetsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource Padding.Page.Current}" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{loc:Loc Budgets.Intro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Budgets.Add.Title}" Command="{Binding AddCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Month selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronLeft" Command="{Binding PreviousMonthCommand}"
                        ToolTip="{loc:Loc Budgets.PrevMonth}" AutomationProperties.Name="{loc:Loc Budgets.PrevMonth}" />
                <TextBlock Text="{Binding MonthText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" MinWidth="160" TextAlignment="Center" />
                <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronRight" Command="{Binding NextMonthCommand}"
                        ToolTip="{loc:Loc Budgets.NextMonth}" AutomationProperties.Name="{loc:Loc Budgets.NextMonth}" />
                <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Budgets.ThisMonth}" Command="{Binding ThisMonthCommand}" Margin="12,0,0,0"
                        Visibility="{Binding IsCurrentMonth, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>

            <!-- Totals -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Budgets.TotalSpent}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,4,0,0">
                                <Run Text="{Binding TotalSpentText, Mode=OneWay}" /><Run Text=" / " Foreground="{DynamicResource Brush.Text.Tertiary}" /><Run Text="{Binding TotalLimitText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRemainingText}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalOver}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Value="{Binding TotalBarPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8" Height="8" />
                    <TextBlock Text="{Binding DefaultThresholdText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <c:AstraIcon Data="{StaticResource Icon.Budgets}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{loc:Loc Budgets.Empty.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Budgets.Empty.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                    <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Budgets.Add.Title}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Budgets -->
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:BudgetRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" VerticalAlignment="Top">
                                    <Ellipse Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Opacity="0.18" />
                                    <c:AstraIcon IconKey="{Binding IconKey}" Width="20" Height="20" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                                            <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource Brush.Success.Subtle}">
                                                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Success}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}">
                                            <Run Text="{Binding SpentText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{Binding LimitText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar x:Name="Bar" Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,6" Height="8"
                                                 Foreground="{DynamicResource Brush.Success}" />
                                    <Grid>
                                        <TextBlock x:Name="Remaining" Text="{Binding RemainingText}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.Transactions" ToolTip="{loc:Loc Budgets.ShowExpenses}"
                                            AutomationProperties.Name="{loc:Loc Budgets.ShowExpenses}"
                                            Command="{Binding DataContext.OpenTransactionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.Pencil" ToolTip="{loc:Loc Budgets.Edit.Title}"
                                            AutomationProperties.Name="{loc:Loc Budgets.Edit.Title}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.X" ToolTip="{loc:Loc Budgets.Delete.Title}"
                                            AutomationProperties.Name="{loc:Loc Budgets.Delete.Title}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Exceeded">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="Remaining" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
