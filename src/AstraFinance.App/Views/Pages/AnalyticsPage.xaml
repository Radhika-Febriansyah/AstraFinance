<UserControl x:Class="AstraFinance.App.Views.Pages.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:AnalyticsViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,12,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="MinHeight" Value="340" />
        </Style>
        <!-- Clickable list row that stretches to the full width (category drill-down). -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Placeholder shown instead of a chart when the period has nothing to show. -->
        <DataTemplate x:Key="EmptyChart">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                <c:AstraIcon Data="{StaticResource Icon.Analytics}" Width="26" Height="26" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource Padding.Page.Current}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{loc:Loc Analytics.Intro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <!-- Period -->
            <Border Style="{StaticResource Toolbar}" Padding="12,10,12,2" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <c:ChoiceGroup ItemsSource="{Binding PeriodOptions}" Focusable="False" Margin="0,0,16,8"
                               AutomationProperties.Name="{loc:Loc Analytics.Period}">
                    <c:ChoiceGroup.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </c:ChoiceGroup.ItemsPanel>
                    <c:ChoiceGroup.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="AnalyticsPeriod" Margin="0,0,6,0"
                                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </c:ChoiceGroup.ItemTemplate>
                </c:ChoiceGroup>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronLeft" Command="{Binding PreviousCommand}"
                            ToolTip="{loc:Loc Analytics.Previous}" AutomationProperties.Name="{loc:Loc Analytics.Previous}" />
                    <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" MinWidth="150" TextAlignment="Center" Margin="8,0" />
                    <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronRight" Command="{Binding NextCommand}"
                            ToolTip="{loc:Loc Analytics.Next}" AutomationProperties.Name="{loc:Loc Analytics.Next}" />
                    <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Analytics.ThisPeriod}" Command="{Binding ThisPeriodCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                    <DatePicker SelectedDate="{Binding CustomFrom, Converter={StaticResource DateOnlyToDateTime}}" Width="170"
                                AutomationProperties.HelpText="{loc:Loc Analytics.Custom.From}" />
                    <TextBlock Text="–" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0" />
                    <DatePicker SelectedDate="{Binding CustomTo, Converter={StaticResource DateOnlyToDateTime}}" Width="170"
                                AutomationProperties.HelpText="{loc:Loc Analytics.Custom.To}" />
                    <TextBlock Text="{Binding CustomRangeError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding CustomRangeError, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </WrapPanel>
            </Border>

            <!-- Empty period -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <c:AstraIcon Data="{StaticResource Icon.Analytics}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{loc:Loc Analytics.Empty.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Analytics.Empty.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <!-- KPIs -->
                <UniformGrid x:Name="KpiGrid" Columns="4" Margin="0,0,-16,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource IconTile.Success}" Width="32" Height="32" CornerRadius="9">
                                    <c:AstraIcon Data="{StaticResource Icon.ArrowDownLeft}" Width="16" Height="16" />
                                </Border>
                                <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding IncomeText}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Text="{Binding CountsText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource IconTile.Danger}" Width="32" Height="32" CornerRadius="9">
                                    <c:AstraIcon Data="{StaticResource Icon.ArrowUpRight}" Width="16" Height="16" />
                                </Border>
                                <TextBlock Text="{loc:Loc Dashboard.Expenses}" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding ExpenseText}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource Brush.Danger}" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                <Run Text="{loc:Loc Analytics.AverageDaily}" /><Run Text=" " /><Run Text="{Binding AverageDailyText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource IconTile.Small}" Width="32" Height="32" CornerRadius="9">
                                    <c:AstraIcon Data="{StaticResource Icon.Scale}" Width="16" Height="16" />
                                </Border>
                                <TextBlock Text="{loc:Loc Analytics.Net}" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="NetValue" Text="{Binding NetText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SavingsRateText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource IconTile.Warning}" Width="32" Height="32" CornerRadius="9">
                                    <c:AstraIcon Data="{StaticResource Icon.AlertTriangle}" Width="16" Height="16" />
                                </Border>
                                <TextBlock Text="{loc:Loc Analytics.LargestExpense}" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding LargestExpenseText}" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding LargestExpenseText, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{loc:Loc Analytics.NoExpenses}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Charts -->
                <UniformGrid x:Name="ChartGrid" Columns="2" Margin="0,0,-16,0">
                    <!-- Income vs expenses -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Analytics.IncomeVsExpenses}" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{Binding SeriesCaption}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Danger}" />
                                    <TextBlock Text="{loc:Loc Dashboard.Expenses}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </Grid>
                            <lvc:CartesianChart x:Name="IncomeExpenseChart" Height="260" Background="Transparent"
                                                AutomationProperties.Name="{loc:Loc Analytics.IncomeVsExpenses}" />
                        </DockPanel>
                    </Border>

                    <!-- Cash flow -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc Analytics.CashFlow}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{loc:Loc Analytics.CashFlow.Caption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <lvc:CartesianChart x:Name="CashFlowChart" Height="260" Background="Transparent"
                                                AutomationProperties.Name="{loc:Loc Analytics.CashFlow}" />
                        </DockPanel>
                    </Border>

                    <!-- Expense breakdown -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Analytics.ExpenseBreakdown}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                            <Grid>
                                <ContentControl Content="{loc:Loc Analytics.NoExpenses}" ContentTemplate="{StaticResource EmptyChart}" Focusable="False"
                                                Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <Grid Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <lvc:PieChart x:Name="ExpenseChart" Width="200" Height="200" VerticalAlignment="Top" Background="Transparent"
                                                  AutomationProperties.Name="{loc:Loc Analytics.ExpenseBreakdown}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ExpenseBreakdown}" Focusable="False" Margin="16,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pages:CategoryShare}">
                                                <Button Style="{StaticResource RowButton}"
                                                        ToolTip="{loc:Loc Analytics.ShowTransactions}" AutomationProperties.Name="{Binding Name}"
                                                        Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <Run Text="{Binding AmountText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" /><Run Text="  " /><Run Text="{Binding PercentText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Income sources -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Analytics.IncomeSources}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                            <Grid>
                                <ContentControl Content="{loc:Loc Analytics.NoIncome}" ContentTemplate="{StaticResource EmptyChart}" Focusable="False"
                                                Visibility="{Binding HasIncome, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding IncomeSources}" Focusable="False" Visibility="{Binding HasIncome, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:CategoryShare}">
                                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,4"
                                                    ToolTip="{loc:Loc Analytics.ShowTransactions}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Text.Caption}" VerticalAlignment="Center">
                                                            <Run Text="{Binding AmountText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" /><Run Text="  " /><Run Text="{Binding PercentText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Success}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Monthly trends -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Analytics.MonthlyTrends}" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{loc:Loc Analytics.MonthlyTrends.Caption}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Danger}" />
                                    <TextBlock Text="{loc:Loc Dashboard.Expenses}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <ContentControl Content="{loc:Loc Analytics.NoTrend}" ContentTemplate="{StaticResource EmptyChart}" Focusable="False"
                                                Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <lvc:CartesianChart x:Name="TrendChart" Height="260" Background="Transparent"
                                                    AutomationProperties.Name="{loc:Loc Analytics.MonthlyTrends}"
                                                    Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Spending habits -->
                    <Border Style="{StaticResource ChartCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc Analytics.SpendingHabits}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding TopWeekdayText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid>
                                <ContentControl Content="{loc:Loc Analytics.NoExpenses}" ContentTemplate="{StaticResource EmptyChart}" Focusable="False"
                                                Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <lvc:CartesianChart x:Name="WeekdayChart" Height="260" Background="Transparent"
                                                    AutomationProperties.Name="{loc:Loc Analytics.SpendingHabits}"
                                                    Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
