<UserControl x:Class="AstraFinance.App.Views.Pages.SavingsGoalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:SavingsGoalsViewModel}">
    <UserControl.Resources>
        <Style x:Key="GoalCard" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="320" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Style="{StaticResource Card}" Padding="18">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Padding.Page.Current}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Goals.Add.Title}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <!-- How allocation works -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12" MaxWidth="820" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:AstraIcon Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Paragraph}" TextWrapping="Wrap">
                            <Run Text="{loc:Loc Goals.Explainer}" /><Run Text=" " /><Run Text="{loc:Loc Goals.TotalAllocated}" /><Run Text=" " /><Run Text="{Binding TotalAllocatedText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Over-allocation warning -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12" MaxWidth="820" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}"
                        Visibility="{Binding OverAllocationWarning, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon Data="{StaticResource Icon.AlertTriangle}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{Binding OverAllocationWarning}" Style="{StaticResource Text.Paragraph}" Foreground="{DynamicResource Brush.Text.Primary}" MaxWidth="740" />
                    </StackPanel>
                </Border>

                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowArchived}" Content="{loc:Loc Goals.ShowArchived}" Margin="0,4,0,16" />

                <!-- Empty -->
                <Border Style="{StaticResource Card}" Padding="32" MaxWidth="820" HorizontalAlignment="Left"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                        <c:AstraIcon Data="{StaticResource Icon.SavingsGoals}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBlock Text="{loc:Loc Goals.Empty.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="{loc:Loc Goals.Empty.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                        <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Goals.Add.Title}" Command="{Binding AddCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Goals}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:GoalCardViewModel}">
                            <Button Style="{StaticResource GoalCard}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40">
                                            <Ellipse Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Opacity="0.18" />
                                            <c:AstraIcon IconKey="{Binding IconKey}" Width="20" Height="20" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" MaxWidth="170" />
                                                <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Background="{DynamicResource Brush.Selected}" Margin="8,0,0,0" Padding="6,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TargetDateText}" Style="{StaticResource Text.Caption}"
                                                       Visibility="{Binding TargetDateText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0">
                                        <Run Text="{Binding AllocatedText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="18" /><Run Text=" / " /><Run Text="{Binding TargetText, Mode=OneWay}" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,6"
                                                 Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                    <Grid>
                                        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding PaceText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,6,0,0"
                                               Visibility="{Binding PaceText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Goal details -->
        <Border Grid.Column="1" Width="340" Margin="16,0,0,0" Style="{StaticResource Card}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="{loc:Loc Goals.Details.Title}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Goals.Details.Title}" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" HorizontalAlignment="Right" c:Assist.Icon="Icon.X"
                                ToolTip="{loc:Loc Dialog.Close}" AutomationProperties.Name="{loc:Loc Dialog.Close}" Command="{Binding CloseDetailsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Style="{StaticResource Text.Secondary}">
                        <Run Text="{Binding Selected.AllocatedText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{Binding Selected.TargetText, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Value="{Binding Selected.BarPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,4"
                                 Foreground="{Binding Selected.ColorHex, Converter={StaticResource HexToBrush}}" />
                    <TextBlock Text="{Binding Selected.RemainingText}" Style="{StaticResource Text.Caption}" />

                    <!-- Actions -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding Selected.IsArchived, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Goals.Allocate.Title}" HorizontalAlignment="Stretch"
                                Command="{Binding AllocateCommand}" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button c:Assist.Icon="Icon.ArrowLeft" Content="{loc:Loc Goals.Release.Title}" Command="{Binding ReleaseCommand}" Margin="0,0,4,0" />
                            <Button c:Assist.Icon="Icon.Pencil" Content="{loc:Loc Goals.Edit.Title}" Command="{Binding EditCommand}" Margin="4,0,0,0" />
                        </UniformGrid>
                        <Button Style="{StaticResource Button.Ghost}" c:Assist.Icon="Icon.CircleCheck" Content="{loc:Loc Goals.MarkCompleted}" HorizontalAlignment="Stretch"
                                Command="{Binding MarkCompletedCommand}" Visibility="{Binding Selected.IsActive, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Ghost}" c:Assist.Icon="Icon.SavingsGoals" Content="{loc:Loc Goals.Reopen}" HorizontalAlignment="Stretch"
                                Command="{Binding ReopenCommand}" Visibility="{Binding Selected.IsCompleted, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Brush.Danger}" c:Assist.Icon="Icon.Folder" Content="{loc:Loc Goals.Archive.Confirm}"
                                HorizontalAlignment="Stretch" Command="{Binding ArchiveCommand}" />
                    </StackPanel>

                    <!-- Allocated per account -->
                    <TextBlock Text="{loc:Loc Goals.ByAccount}" Style="{StaticResource Text.Overline}" Margin="0,20,0,6" />
                    <ItemsControl ItemsSource="{Binding Shares}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- History -->
                    <TextBlock Text="{loc:Loc Goals.History}" Style="{StaticResource Text.Overline}" Margin="0,20,0,6" />
                    <TextBlock Text="{loc:Loc Goals.History.Empty}" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:GoalHistoryRow}">
                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountName}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="{Binding Caption, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock x:Name="Amount" Text="{Binding AmountText}" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRelease}" Value="True">
                                        <Setter TargetName="Amount" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
