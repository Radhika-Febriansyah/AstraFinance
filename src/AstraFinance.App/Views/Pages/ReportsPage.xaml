<UserControl x:Class="AstraFinance.App.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:ReportsViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource Padding.Page.Current}" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{loc:Loc Reports.Intro}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,20" TextWrapping="Wrap" />

            <Grid x:Name="Layout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="300" />
                    <ColumnDefinition x:Name="RightColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Report -->
                <Border x:Name="ReportCard" Style="{StaticResource Card}" Margin="0,0,16,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Reports.Step.Report}" Style="{StaticResource StepLabel}" />
                        <c:ChoiceGroup ItemsSource="{Binding ReportOptions}" Focusable="False" AutomationProperties.Name="{loc:Loc Reports.Step.Report}">
                            <c:ChoiceGroup.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="ReportKind" Margin="0,0,0,6"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                 c:Assist.Icon="{Binding IconKey}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </c:ChoiceGroup.ItemTemplate>
                        </c:ChoiceGroup>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="OptionsPanel" Grid.Column="1">
                    <!-- 2. Period and 3. Format -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding KindDescription}" Style="{StaticResource Text.Paragraph}" Margin="0,0,0,16" />

                            <TextBlock Text="{loc:Loc Reports.Step.Period}" Style="{StaticResource StepLabel}" />
                            <c:ChoiceGroup ItemsSource="{Binding PeriodOptions}" Focusable="False" AutomationProperties.Name="{loc:Loc Reports.Step.Period}">
                                <c:ChoiceGroup.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </c:ChoiceGroup.ItemsPanel>
                                <c:ChoiceGroup.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="ReportPeriod" Margin="0,0,6,6"
                                                     Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </c:ChoiceGroup.ItemTemplate>
                            </c:ChoiceGroup>
                            <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                <DatePicker SelectedDate="{Binding CustomFrom, Converter={StaticResource DateOnlyToDateTime}}" Width="170"
                                            AutomationProperties.HelpText="{loc:Loc Analytics.Custom.From}" />
                                <TextBlock Text="–" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0" />
                                <DatePicker SelectedDate="{Binding CustomTo, Converter={StaticResource DateOnlyToDateTime}}" Width="170"
                                            AutomationProperties.HelpText="{loc:Loc Analytics.Custom.To}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PeriodError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,6,0,0"
                                       Visibility="{Binding PeriodError, Converter={StaticResource NullToVisibility}}" />

                            <TextBlock Text="{loc:Loc Reports.Step.Format}" Style="{StaticResource StepLabel}" Margin="0,18,0,8" />
                            <c:ChoiceGroup ItemsSource="{Binding FormatOptions}" Focusable="False" AutomationProperties.Name="{loc:Loc Reports.Step.Format}">
                                <c:ChoiceGroup.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </c:ChoiceGroup.ItemsPanel>
                                <c:ChoiceGroup.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="ReportFormat" Margin="0,0,6,6"
                                                     c:Assist.Icon="{Binding IconKey}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </c:ChoiceGroup.ItemTemplate>
                            </c:ChoiceGroup>
                        </StackPanel>
                    </Border>

                    <!-- Preview and export -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Reports.Preview}" Style="{StaticResource Text.Overline}" />
                                    <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Text.Title}" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding PreviewPeriod}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.HardDriveDownload" Content="{loc:Loc Reports.Export.Button}"
                                        Command="{Binding ExportCommand}" c:Assist.IsBusy="{Binding IsExporting}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Summary cards -->
                            <ItemsControl ItemsSource="{Binding PreviewSummary}" Focusable="False" Margin="0,16,-12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:ReportPreviewLine}">
                                        <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Surface.Raised}" Padding="14,12" Margin="0,0,12,12"
                                                MinWidth="170" MaxWidth="260">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Title}" FontSize="18" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Contents of the export: one structured table per section -->
                            <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Margin="0,4,0,0">
                                <StackPanel>
                                    <Grid Margin="14,10">
                                        <TextBlock Text="{loc:Loc Reports.Contents}" Style="{StaticResource Text.Overline}" />
                                        <TextBlock Text="{loc:Loc Reports.Contents.Rows}" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PreviewTables}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pages:ReportPreviewLine}">
                                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}" Padding="14,10">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource IconTile.Neutral}" Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                                                                <c:AstraIcon Data="{StaticResource Icon.Layers}" Width="14" Height="14" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <c:AstraIcon Data="{StaticResource Icon.CircleCheck}" Width="16" Height="16" Foreground="{DynamicResource Brush.Success}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding PreviewCountText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Last export -->
                            <Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Brush.Success.Subtle}"
                                    Visibility="{Binding HasLastExport, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Reports.Open}" Command="{Binding OpenLastExportCommand}" Margin="12,0,0,0" />
                                        <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Reports.ShowInFolder}" Command="{Binding ShowLastExportInFolderCommand}" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Reports.Saved}" Style="{StaticResource Text.BodyStrong}" />
                                        <TextBlock Text="{Binding LastExportPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastExportPath}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
