<UserControl x:Class="AstraFinance.App.Views.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:AccountsViewModel}">
    <UserControl.Resources>
        <!-- Account icon in its color: a tinted circle -->
        <DataTemplate x:Key="AccountBadge" DataType="{x:Type pages:AccountItemViewModel}">
            <Grid Width="40" Height="40">
                <Ellipse Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Opacity="0.18" />
                <c:AstraIcon IconKey="{Binding IconKey}" Width="20" Height="20" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="AccountCard" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Style="{StaticResource Card}" Padding="18">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryRow" DataType="{x:Type pages:AccountHistoryRow}">
            <Grid Margin="0,0,0,2">
                <Border Padding="12,10" CornerRadius="{StaticResource Radius.Control}" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.Surface.Raised}" VerticalAlignment="Center">
                            <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" />
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Subtitle, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="Amount" Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                    <Setter TargetName="Amount" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ================= List ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsDetailsMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel Margin="{DynamicResource Padding.Page.Current}">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus"
                            Content="{loc:Loc Accounts.Add.Title}" Command="{Binding AddAccountCommand}" />
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,20" HorizontalAlignment="Left" MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Accounts.Total}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding TotalBalanceText}" Style="{StaticResource Text.Display}" FontSize="28" Margin="0,4,0,2" />
                        <TextBlock Text="{loc:Loc Accounts.Total.Hint}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </StackPanel>
                </Border>

                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowInactive}" Content="{loc:Loc Accounts.ShowInactive}" Margin="0,0,0,16" />

                <Control Style="{StaticResource Spinner}" HorizontalAlignment="Left" Margin="4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Left" Margin="0,24" MaxWidth="420" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <c:AstraIcon Data="{StaticResource Icon.Accounts}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Left" />
                    <TextBlock Text="{loc:Loc Accounts.Empty.Title}" Style="{StaticResource Text.Subtitle}" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Accounts.Empty.Body}" Style="{StaticResource Text.Paragraph}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:AccountItemViewModel}">
                            <Button Style="{StaticResource AccountCard}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AccountBadge}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" MaxWidth="160" />
                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.Selected}" Margin="8,0,0,0" Padding="6,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                <TextBlock Text="{loc:Loc Accounts.Inactive}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,10" />
                                        <TextBlock x:Name="Balance" Text="{Binding BalanceText}" Style="{StaticResource Text.Title}" FontSize="18" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                    <Setter TargetName="Balance" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter TargetName="Balance" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Details ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsDetailsMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="{DynamicResource Padding.Page.Current}" DataContext="{Binding}">
                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="6,0" Margin="-6,0,0,12"
                        c:Assist.Icon="Icon.ArrowLeft" Content="{loc:Loc Accounts.Back}" Command="{Binding BackToListCommand}" />

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Selected}" ContentTemplate="{StaticResource AccountBadge}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.PageTitle}" />
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.Selected}" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Selected.IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="{loc:Loc Accounts.Inactive}" Style="{StaticResource Text.Caption}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.TypeText}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,20">
                    <Button c:Assist.Icon="Icon.Pencil" Content="{loc:Loc Accounts.Edit.Title}" Command="{Binding EditCommand}" Margin="0,0,8,8" />
                    <Button c:Assist.Icon="Icon.Transactions" Content="{loc:Loc Accounts.Transfer}" Command="{Binding TransferCommand}" Margin="0,0,8,8"
                            IsEnabled="{Binding Selected.IsActive}" />
                    <Button c:Assist.Icon="Icon.Scale" Content="{loc:Loc Accounts.Adjust.Title}" Command="{Binding AdjustBalanceCommand}" Margin="0,0,8,8"
                            IsEnabled="{Binding Selected.IsActive}" />
                    <Button c:Assist.Icon="Icon.Power" Command="{Binding ToggleActiveCommand}" Margin="0,0,8,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{loc:Loc Accounts.Deactivate.Confirm}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected.IsActive}" Value="False">
                                        <Setter Property="Content" Value="{loc:Loc Accounts.Reactivate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <WrapPanel>
                    <!-- Balance breakdown -->
                    <Border Style="{StaticResource Card}" Width="340" Margin="0,0,20,20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Accounts.Breakdown.Title}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Breakdown}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:BreakdownRow}">
                                        <Grid x:Name="Row" Margin="0,4">
                                            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource Text.Secondary}" />
                                            <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                                                <Setter TargetName="Row" Property="Margin" Value="0,12,0,0" />
                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                <Setter TargetName="Value" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="Value" Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Adjustments -->
                    <Border Style="{StaticResource Card}" Width="420" Margin="0,0,20,20" VerticalAlignment="Top"
                            Visibility="{Binding HasAdjustments, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Accounts.Adjustments.Title}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Adjustments}" ItemTemplate="{StaticResource HistoryRow}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Transaction history -->
                <Border Style="{StaticResource Card}" MaxWidth="780" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Accounts.History.Title}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Loc Accounts.History.Empty}" Style="{StaticResource Text.Paragraph}" Margin="0,4,0,4"
                                   Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:AccountHistoryRow}">
                                    <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRow}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Content="{loc:Loc Accounts.History.More}"
                                Command="{Binding LoadMoreHistoryCommand}" Margin="0,8,0,0"
                                Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
