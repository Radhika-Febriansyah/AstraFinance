<UserControl x:Class="AstraFinance.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:svc="clr-namespace:AstraFinance.App.Services"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:DashboardViewModel}">
    <UserControl.Resources>
        <!-- Whole card is clickable (navigates to its detail page). -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Style="{StaticResource Card}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource Padding.Page.Current}" MaxWidth="1240">
            <!-- Greeting -->
            <!-- Quick Add lives in the top bar (and the empty-state link below); no duplicate button here. -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.Display}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Secondary}" FontSize="{StaticResource FontSize.Subtitle}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Summary cards -->
            <UniformGrid x:Name="SummaryGrid" Columns="3" Margin="-8,0,-8,8">
                <Button Style="{StaticResource CardButton}" Margin="8,0,8,16" Command="{Binding OpenAccountsCommand}"
                        AutomationProperties.Name="{loc:Loc Dashboard.TotalBalance}" ToolTip="{loc:Loc Dashboard.TotalBalance.Tooltip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:AstraIcon Data="{StaticResource Icon.Accounts}" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc Dashboard.TotalBalance}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalBalanceText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AccountsText}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:AstraIcon Data="{StaticResource Icon.ArrowDownLeft}" Width="16" Height="16" Foreground="{DynamicResource Brush.Success}" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc Dashboard.MonthIncome}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MonthIncomeText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding MonthName}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:AstraIcon Data="{StaticResource Icon.ArrowUpRight}" Width="16" Height="16" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc Dashboard.MonthExpense}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MonthExpenseText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding MonthNetText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthNetNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Cash flow + recent -->
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="3*" />
                    <ColumnDefinition x:Name="RightColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cash flow -->
                <Button x:Name="CashFlowCard" Style="{StaticResource CardButton}" Margin="0,0,16,16" Command="{Binding OpenAnalyticsCommand}"
                        AutomationProperties.Name="{loc:Loc Dashboard.CashFlow}" ToolTip="{loc:Loc Dashboard.CashFlow.Tooltip}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Dashboard.CashFlow}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding CashFlowPeriodText}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasNoCashFlow, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Success}" />
                                <TextBlock Text="{loc:Loc TransactionType.Income}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource Brush.Danger}" />
                                <TextBlock Text="{loc:Loc Dashboard.Expenses}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </Grid>
                        <Grid Height="260">
                            <lvc:CartesianChart x:Name="CashFlowChart" Background="Transparent" IsHitTestVisible="True"
                                                AutomationProperties.Name="{loc:Loc Dashboard.CashFlow}"
                                                Visibility="{Binding HasNoCashFlow, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                        Visibility="{Binding HasNoCashFlow, Converter={StaticResource BoolToVisibility}}">
                                <c:AstraIcon Data="{StaticResource Icon.Analytics}" Width="28" Height="28" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{loc:Loc Dashboard.CashFlow.Empty}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Button>

                <!-- Recent transactions -->
                <Border x:Name="RecentCard" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Dashboard.Recent}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Content="{loc:Loc Dashboard.ViewAll}"
                                    Command="{Binding OpenTransactionsCommand}"
                                    Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </Grid>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                        Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVisibility}}">
                                <c:AstraIcon Data="{StaticResource Icon.Transactions}" Width="28" Height="28" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{loc:Loc Transactions.Empty.Title}" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Center" Content="{loc:Loc Dashboard.AddFirst}"
                                        Command="{Binding QuickAddCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                        <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.OpenTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Margin="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.Surface.Raised}">
                                                    <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" />
                                                    <TextBlock Style="{StaticResource Text.Caption}">
                                                        <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AccountText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock x:Name="Amount" Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                                <Setter TargetName="Amount" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                                                <Setter TargetName="Amount" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Budget summary: budgets for this month, most at risk first -->
                <Border x:Name="BudgetCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Dashboard.Budgets}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Content="{loc:Loc Dashboard.ViewAll}"
                                    Command="{Binding OpenBudgetsCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasNoBudgets, Converter={StaticResource BoolToVisibility}}">
                            <c:AstraIcon Data="{StaticResource Icon.Budgets}" Width="18" Height="18" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Dashboard.Budgets.Empty}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Budgets.Add.Title}" Command="{Binding OpenBudgetsCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Budgets}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:BudgetRowViewModel}">
                                    <StackPanel Margin="0,8,24,8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar x:Name="Bar" Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,4"
                                                     Foreground="{DynamicResource Brush.Success}" />
                                        <TextBlock x:Name="Detail" Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding SpentText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding LimitText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RemainingText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                            <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Exceeded">
                                            <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreBudgetsText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding MoreBudgetsText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
