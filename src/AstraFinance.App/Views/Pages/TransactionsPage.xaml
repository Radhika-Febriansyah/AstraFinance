<UserControl x:Class="AstraFinance.App.Views.Pages.TransactionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:svc="clr-namespace:AstraFinance.App.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:TransactionsViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />

        <Style x:Key="AmountText" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Padding.Page.Current}" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button c:Assist.Icon="Icon.HardDriveDownload" Content="{loc:Loc Transactions.Export.Button}" Command="{Binding ExportCommand}"
                        c:Assist.IsBusy="{Binding IsExporting}" Margin="0,0,8,0" ToolTip="{loc:Loc Transactions.Export.Tooltip}" />
                <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Transactions.Add.Title}" Command="{Binding AddCommand}" />
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBox Width="260" Margin="0,0,8,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" c:Assist.Icon="Icon.Search"
                     c:Assist.Placeholder="{loc:Loc Transactions.Filter.Search}" AutomationProperties.Name="{loc:Loc Transactions.Filter.Search}" />
            <ComboBox Width="170" Margin="0,0,8,8" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:Loc Transactions.Filter.Period}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVisibility}}">
                <DatePicker Width="150" Margin="0,0,4,8" SelectedDate="{Binding CustomFrom, Converter={StaticResource DateOnlyToDateTime}}"
                            AutomationProperties.HelpText="{loc:Loc Transactions.Filter.From}" />
                <TextBlock Text="–" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="2,0,6,8" />
                <DatePicker Width="150" Margin="0,0,8,8" SelectedDate="{Binding CustomTo, Converter={StaticResource DateOnlyToDateTime}}"
                            AutomationProperties.HelpText="{loc:Loc Transactions.Filter.To}" />
            </StackPanel>
            <ComboBox Width="190" Margin="0,0,8,8" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:Loc Transactions.Field.Category}" />
            <ComboBox Width="170" Margin="0,0,8,8" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccountFilter}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:Loc Transactions.Field.Account}" />
        </WrapPanel>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <c:ChoiceGroup ItemsSource="{Binding TypeOptions}" Focusable="False" HorizontalAlignment="Left"
                          AutomationProperties.Name="{loc:Loc Transactions.Field.Type}">
                <c:ChoiceGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </c:ChoiceGroup.ItemsPanel>
                <c:ChoiceGroup.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="TypeFilter" MinHeight="32" Padding="12,0"
                                     Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </c:ChoiceGroup.ItemTemplate>
            </c:ChoiceGroup>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Link}" Content="{loc:Loc Transactions.Filter.Clear}" Command="{Binding ClearFiltersCommand}"
                        Margin="0,8,16,0" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowDeleted}" Content="{loc:Loc Transactions.ShowDeleted}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Table / empty states -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          Sorting="Grid_Sorting" AutomationProperties.Name="{Binding Title}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="DateColumn" Header="{loc:Loc Transactions.Column.Date}" SortMemberPath="Date" CanUserSort="True"
                                                SortDirection="Descending" Width="SizeToCells" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Secondary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Transactions.Column.Description}" CanUserSort="False" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Brush.Surface.Raised}" Margin="0,0,10,0">
                                            <c:AstraIcon IconKey="{Binding IconKey}" Width="15" Height="15" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                                        <c:AstraIcon Data="{StaticResource Icon.Reports}" Width="13" Height="13" Margin="6,0,0,0"
                                                     Foreground="{DynamicResource Brush.Text.Tertiary}" ToolTip="{Binding Notes}"
                                                     Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="CategoryColumn" Header="{loc:Loc Transactions.Column.Category}" CanUserSort="False" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Text.Secondary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="AccountColumn" Header="{loc:Loc Transactions.Column.Account}" CanUserSort="False" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <TextBlock Text="{Binding AccountText}" Style="{StaticResource Text.Secondary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Transactions.Column.Amount}" SortMemberPath="Amount" CanUserSort="True" Width="SizeToCells" MinWidth="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="TypeColumn" Header="{loc:Loc Transactions.Column.Type}" CanUserSort="False" Width="SizeToCells" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:TransactionRowViewModel}">
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.Selected}">
                                        <TextBlock Text="{Binding TypeText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty: no data at all -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"
                            Visibility="{Binding HasNoRecordsAtAll, Converter={StaticResource BoolToVisibility}}">
                    <c:AstraIcon Data="{StaticResource Icon.Transactions}" Width="32" Height="32" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{loc:Loc Transactions.Empty.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Transactions.Empty.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                    <Button Style="{StaticResource Button.Primary}" c:Assist.Icon="Icon.Plus" Content="{loc:Loc Transactions.Add.Title}"
                            Command="{Binding AddCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Empty: filters match nothing -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding HasNoRecordsAtAll}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <c:AstraIcon Data="{StaticResource Icon.Search}" Width="28" Height="28" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{loc:Loc Transactions.NoMatch.Title}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{loc:Loc Transactions.NoMatch.Body}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details panel -->
        <Border x:Name="DetailsPanel" Grid.Row="3" Grid.Column="1" Width="320" Margin="16,0,0,0" Style="{StaticResource Card}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="{loc:Loc Transactions.Details.Title}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel DataContext="{Binding Selected}">
                    <Grid>
                        <TextBlock Text="{loc:Loc Transactions.Details.Title}" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" HorizontalAlignment="Right" c:Assist.Icon="Icon.X"
                                ToolTip="{loc:Loc Dialog.Close}" AutomationProperties.Name="{loc:Loc Dialog.Close}"
                                Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource AmountText}" HorizontalAlignment="Left" FontSize="26" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />

                    <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.Danger.Subtle}" Margin="0,10,0,0"
                            Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Transactions.Details.Deleted}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" FontWeight="SemiBold" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,10,0,0" Visibility="{Binding IsFee, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Transactions.Details.FeeBadge}" Style="{StaticResource Badge.Text}" />
                    </Border>

                    <TextBlock Text="{loc:Loc Transactions.Column.Type}" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="{loc:Loc Transactions.Column.Date}" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="{loc:Loc Transactions.Column.Category}" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="{loc:Loc Transactions.Column.Account}" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding AccountText}" Style="{StaticResource DetailValue}" />
                    <StackPanel Visibility="{Binding DataContext.SelectedFeeText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{loc:Loc Transactions.Field.Fee}" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DataContext.SelectedFeeText, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{loc:Loc Transactions.Field.Notes}" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Transactions.Details.Created}" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding DataContext.SelectedCreatedText, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource DetailValue}" />

                    <!-- Actions -->
                    <StackPanel Margin="0,20,0,0" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Button c:Assist.Icon="Icon.Pencil" Content="{loc:Loc Transactions.Edit.Title}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Style="{StaticResource Button.Ghost}" c:Assist.Icon="Icon.Transactions" Content="{loc:Loc Transactions.Details.OpenTransfer}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8" Visibility="{Binding IsFee, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.OpenParentTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Brush.Danger}" c:Assist.Icon="Icon.X"
                                Content="{loc:Loc Transactions.Delete.Confirm}" HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Primary}" Content="{loc:Loc Transactions.Restore}" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                            Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer: summary + paging -->
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronLeft" Command="{Binding PreviousPageCommand}"
                        ToolTip="{loc:Loc Transactions.PrevPage}" AutomationProperties.Name="{loc:Loc Transactions.PrevPage}" />
                <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0" />
                <Button Style="{StaticResource Button.Icon}" c:Assist.Icon="Icon.ChevronRight" Command="{Binding NextPageCommand}"
                        ToolTip="{loc:Loc Transactions.NextPage}" AutomationProperties.Name="{loc:Loc Transactions.NextPage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
