<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
                    xmlns:views="clr-namespace:AstraFinance.App.Views.Pages"
                    xmlns:gate="clr-namespace:AstraFinance.App.ViewModels.Gate"
                    xmlns:gateViews="clr-namespace:AstraFinance.App.Views.Gate"
                    xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
                    xmlns:forms="clr-namespace:AstraFinance.App.Views.Forms">
    <!-- Maps page view models to their views (ViewModel-first navigation). -->
    <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
        <views:DashboardPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
        <views:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TransactionsViewModel}">
        <views:TransactionsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:CalendarViewModel}">
        <views:CalendarPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:BudgetsViewModel}">
        <views:BudgetsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SavingsGoalsViewModel}">
        <views:SavingsGoalsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:BudgetFormViewModel}">
        <forms:BudgetForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:GoalFormViewModel}">
        <forms:GoalForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:AllocationFormViewModel}">
        <forms:AllocationForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:AnalyticsViewModel}">
        <views:AnalyticsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ReportsViewModel}">
        <views:ReportsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:BillsViewModel}">
        <views:BillsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:BillFormViewModel}">
        <forms:BillForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:PayBillFormViewModel}">
        <forms:PayBillForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:CategoryFormViewModel}">
        <forms:CategoryForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChangePinFormViewModel}">
        <forms:ChangePinForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ImportFormViewModel}">
        <forms:ImportForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:AccountsViewModel}">
        <views:AccountsPage />
    </DataTemplate>

    <!-- Full-window gates -->
    <DataTemplate DataType="{x:Type gate:OnboardingViewModel}">
        <gateViews:OnboardingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type gate:LockViewModel}">
        <gateViews:LockView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type gate:BusyGateViewModel}">
        <Grid Background="{DynamicResource Brush.Background}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" MaxWidth="460">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Paragraph}" TextAlignment="Center" Margin="0,8,0,18" />
                    <ProgressBar IsIndeterminate="True" Height="4" Width="260" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Dialog forms -->
    <DataTemplate DataType="{x:Type dlg:AccountEditorViewModel}">
        <forms:AccountEditorForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dlg:TransactionFormViewModel}">
        <forms:TransactionForm />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dlg:BalanceAdjustmentViewModel}">
        <forms:BalanceAdjustmentForm />
    </DataTemplate>
</ResourceDictionary>
