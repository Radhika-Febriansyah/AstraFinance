<Window x:Class="AstraFinance.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AstraFinance.App.Controls"
        xmlns:loc="clr-namespace:AstraFinance.App.Localization"
        Title="{loc:Loc App.Name}"
        Width="520" Height="320"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        Background="{StaticResource Brush.Brand.Backdrop}"
        FontFamily="{StaticResource Font.Base}"
        UseLayoutRounding="True" Opacity="0"
        AutomationProperties.Name="{loc:Loc Splash.Loading}">
    <!--
        Splash — "Elegant Dark": Deep Navy in both themes, large symbol, product name and subtle geometric
        detail (faint orbit rings). Shown only while startup work runs; it never adds a delay of its own
        beyond a short minimum that avoids a flash.
    -->
    <Grid ClipToBounds="True">
        <!-- Geometric detail: faint concentric orbit rings rising from the lower right. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="300" Canvas.Top="150" Width="420" Height="420" Stroke="#14FFFFFF" StrokeThickness="1" />
            <Ellipse Canvas.Left="360" Canvas.Top="210" Width="300" Height="300" Stroke="#10FFFFFF" StrokeThickness="1" />
            <Ellipse Canvas.Left="420" Canvas.Top="270" Width="180" Height="180" Stroke="#0CFFFFFF" StrokeThickness="1" />
            <Ellipse Canvas.Left="-140" Canvas.Top="-170" Width="300" Height="300" Stroke="#0CFFFFFF" StrokeThickness="1" />
        </Canvas>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
            <c:AstraIcon Data="{StaticResource Brand.Symbol}" IsFilled="True" Width="88" Height="88"
                         Foreground="{StaticResource Brush.Brand.Gradient.OnDark}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc App.Name}" FontFamily="{StaticResource Font.Display}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.OnBrand}" HorizontalAlignment="Center" Margin="0,18,0,0" />

            <!-- Slim indeterminate loading line -->
            <Border x:Name="Track" Width="120" Height="2" CornerRadius="1" Margin="0,22,0,0" Background="#1FFFFFFF" ClipToBounds="True">
                <Border x:Name="Runner" Width="40" Height="2" CornerRadius="1" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002563EB" Offset="0" />
                            <GradientStop Color="#FF60A5FA" Offset="0.5" />
                            <GradientStop Color="#002563EB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="RunnerOffset" X="-40" />
                    </Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock Text="{loc:Loc Splash.Loading}" FontSize="12" Foreground="{StaticResource Brush.OnBrand.Secondary}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Brush.OnBrand.Secondary}" Opacity="0.8"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,16" />
    </Grid>
</Window>
