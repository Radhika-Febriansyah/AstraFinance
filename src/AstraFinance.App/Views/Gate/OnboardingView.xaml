<UserControl x:Class="AstraFinance.App.Views.Gate.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:gate="clr-namespace:AstraFinance.App.ViewModels.Gate"
             xmlns:forms="clr-namespace:AstraFinance.App.Views.Forms"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=gate:OnboardingViewModel}"
             Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <conv:EqualsToVisibilityConverter x:Key="StepVisible" />
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepIntro" TargetType="TextBlock" BasedOn="{StaticResource Text.Paragraph}">
            <Setter Property="Margin" Value="0,8,0,24" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Progress rail -->
        <Border x:Name="Rail" Width="280" Background="{DynamicResource Brush.Sidebar.Brand}">
            <DockPanel Margin="28,28,24,28">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,36">
                    <c:AstraIcon Data="{StaticResource Brand.Symbol}" IsFilled="True" Width="30" Height="30" Foreground="{StaticResource Brush.Brand.Gradient.OnDark}" />
                    <TextBlock Text="{loc:Loc App.Name}" Style="{StaticResource Text.Subtitle}" FontFamily="{StaticResource Font.Display}" FontSize="17"
                               Foreground="{DynamicResource Brush.Sidebar.Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Onboarding.Resume}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           Foreground="{DynamicResource Brush.Sidebar.Text.Secondary}" />
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="{loc:Loc Onboarding.Progress}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type gate:OnboardingStepItem}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Grid Width="28" Height="28">
                                    <Ellipse x:Name="Dot" Fill="{DynamicResource Brush.Sidebar.Hover}" Stroke="#40FFFFFF" StrokeThickness="1.5" />
                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Sidebar.Text.Secondary}" />
                                    <c:AstraIcon x:Name="Check" Data="{StaticResource Icon.Check}" Width="14" Height="14" StrokeThickness="3"
                                                 Foreground="{StaticResource Brush.Brand.Navy}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="Label" Text="{Binding Title}" Style="{StaticResource Text.Base}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Sidebar.Text.Secondary}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Sidebar.Indicator}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Sidebar.Indicator}" />
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Sidebar.Indicator}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Step content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="32,14">
                <Grid MaxWidth="620" HorizontalAlignment="Stretch">
                    <Button Content="{loc:Loc Onboarding.Back}" Command="{Binding BackCommand}" c:Assist.Icon="Icon.ArrowLeft" HorizontalAlignment="Left"
                            Visibility="{Binding IsFirstStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Button x:Name="NextButton" Content="{Binding NextText}" Command="{Binding NextCommand}" Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Right" MinWidth="140" c:Assist.IsBusy="{Binding IsBusy}" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="32,40,32,32" MaxWidth="620">
                    <!-- 1. Welcome -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Welcome}">
                        <TextBlock Text="{loc:Loc Onboarding.Welcome.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Welcome.Body}" Style="{StaticResource StepIntro}" />
                        <TextBlock Text="{loc:Loc Onboarding.Welcome.Language}" Style="{StaticResource FieldLabel}" />
                        <c:ChoiceGroup ItemsSource="{Binding LanguageOptions}" AutomationProperties.Name="{loc:Loc Onboarding.Welcome.Language}">
                            <c:ChoiceGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </c:ChoiceGroup.ItemsPanel>
                            <c:ChoiceGroup.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="OnboardingLanguage" MinWidth="200" MinHeight="48"
                                                 c:Assist.Icon="{Binding IconKey}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </c:ChoiceGroup.ItemTemplate>
                        </c:ChoiceGroup>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:AstraIcon Data="{StaticResource Icon.Shield}" Foreground="{DynamicResource Brush.Accent.Text}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                <TextBlock Text="{loc:Loc About.Privacy}" Style="{StaticResource Text.Paragraph}" MaxWidth="520" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. Regional -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Regional}">
                        <TextBlock Text="{loc:Loc Onboarding.Regional.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Regional.Body}" Style="{StaticResource StepIntro}" />
                        <TextBlock Text="{loc:Loc Onboarding.Regional.Currency}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}" DisplayMemberPath="Label"
                                  IsEnabled="{Binding CanChangeCurrency}" AutomationProperties.Name="{loc:Loc Onboarding.Regional.Currency}" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Loc Onboarding.Regional.CurrencyHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,20" />
                        <TextBlock Text="{loc:Loc Onboarding.Regional.Number}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding NumberFormatOptions}" SelectedItem="{Binding SelectedNumberFormat}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{loc:Loc Onboarding.Regional.Number}" Margin="0,0,0,20" />
                        <TextBlock Text="{loc:Loc Onboarding.Regional.Date}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DateFormatOptions}" SelectedItem="{Binding SelectedDateFormat}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{loc:Loc Onboarding.Regional.Date}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Onboarding.Regional.Preview}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding RegionalPreview}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <!-- 3. First account -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=FirstAccount}">
                        <TextBlock Text="{loc:Loc Onboarding.Account.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Account.Body}" Style="{StaticResource StepIntro}" />
                        <forms:AccountEditorForm DataContext="{Binding AccountEditor}" />
                    </StackPanel>

                    <!-- 4. PIN -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Pin}">
                        <TextBlock Text="{loc:Loc Onboarding.Pin.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Pin.Body}" Style="{StaticResource StepIntro}" />
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,20"
                                Visibility="{Binding HasExistingPin, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <c:AstraIcon Data="{StaticResource Icon.CircleCheck}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Onboarding.Pin.AlreadySet}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Loc Onboarding.Pin.New}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox Style="{StaticResource PinBox}" c:PinBoxAssist.Pin="{Binding Pin, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="240" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Onboarding.Pin.New}" Margin="0,0,0,24" />
                        <TextBlock Text="{loc:Loc Onboarding.Pin.Confirm}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox Style="{StaticResource PinBox}" c:PinBoxAssist.Pin="{Binding ConfirmPin, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="240" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Onboarding.Pin.Confirm}" Margin="0,0,0,24" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <c:AstraIcon Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                <TextBlock Text="{loc:Loc Onboarding.Pin.Note}" Style="{StaticResource Text.Paragraph}" MaxWidth="520" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. Backup -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Backup}">
                        <TextBlock Text="{loc:Loc Onboarding.Backup.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Backup.Body}" Style="{StaticResource StepIntro}" />
                        <TextBlock Text="{loc:Loc Onboarding.Backup.Location}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" c:Assist.Icon="Icon.Folder"
                                     AutomationProperties.Name="{loc:Loc Onboarding.Backup.Location}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Content="{loc:Loc Onboarding.Backup.Browse}" Command="{Binding BrowseBackupFolderCommand}" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Onboarding.Backup.Schedule}" Style="{StaticResource FieldLabel}" />
                        <c:ChoiceGroup ItemsSource="{Binding ScheduleOptions}" AutomationProperties.Name="{loc:Loc Onboarding.Backup.Schedule}" Margin="0,0,0,12">
                            <c:ChoiceGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </c:ChoiceGroup.ItemsPanel>
                            <c:ChoiceGroup.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="BackupSchedule"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </c:ChoiceGroup.ItemTemplate>
                        </c:ChoiceGroup>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <c:AstraIcon Data="{StaticResource Icon.HardDriveDownload}" Foreground="{DynamicResource Brush.Accent.Text}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                <TextBlock Text="{loc:Loc Onboarding.Backup.Manual}" Style="{StaticResource Text.Paragraph}" MaxWidth="520" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. Completion -->
                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisible}, ConverterParameter=Completion}">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.Success.Subtle}" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <c:AstraIcon Data="{StaticResource Icon.Check}" Width="26" Height="26" StrokeThickness="2.5" Foreground="{DynamicResource Brush.Success}" />
                        </Border>
                        <TextBlock Text="{loc:Loc Onboarding.Done.Title}" Style="{StaticResource StepTitle}" />
                        <TextBlock Text="{loc:Loc Onboarding.Done.Body}" Style="{StaticResource StepIntro}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Onboarding.Done.Account}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding SummaryAccount}" Style="{StaticResource Text.BodyStrong}" Margin="0,2,0,12" />
                                <TextBlock Text="{loc:Loc Onboarding.Done.Security}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{loc:Loc Onboarding.Done.SecurityValue}" Style="{StaticResource Text.BodyStrong}" Margin="0,2,0,12" />
                                <TextBlock Text="{loc:Loc Onboarding.Done.Backup}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding SummaryBackup}" Style="{StaticResource Text.BodyStrong}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
