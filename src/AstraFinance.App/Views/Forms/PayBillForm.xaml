<UserControl x:Class="AstraFinance.App.Views.Forms.PayBillForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:PayBillFormViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding BillName}" Style="{StaticResource Text.Subtitle}" />
        <TextBlock Text="{Binding DueText}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,6" />
        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Paragraph}" Margin="0,0,0,18" />

        <TextBlock Text="{loc:Loc Bills.Pay.Amount}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" c:Assist.Placeholder="0"
                 FontSize="20" MinHeight="44" AutomationProperties.Name="{loc:Loc Bills.Pay.Amount}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Bills.Pay.Account}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutomationProperties.Name="{loc:Loc Bills.Pay.Account}" Margin="0,0,0,22">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:AccountOption}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc Bills.Pay.Date}" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding PaidDate, Converter={StaticResource DateOnlyToDateTime}}" Width="220" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="{loc:Loc Bills.Pay.Date}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Goals.Field.Note}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="{loc:Loc Goals.Field.Note}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
