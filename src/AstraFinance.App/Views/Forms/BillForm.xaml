<UserControl x:Class="AstraFinance.App.Views.Forms.BillForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:BillFormViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Loc Bills.Field.Name}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" c:Assist.Placeholder="{loc:Loc Bills.Field.Name.Placeholder}"
                 AutomationProperties.Name="{loc:Loc Bills.Field.Name}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Bills.Field.Amount}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" c:Assist.Placeholder="0"
                 AutomationProperties.Name="{loc:Loc Bills.Field.Amount}" Margin="0,0,0,4" />
        <TextBlock Text="{loc:Loc Bills.Field.Amount.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,18" />

        <TextBlock Text="{loc:Loc Bills.Field.Recurrence}" Style="{StaticResource FieldLabel}" />
        <c:ChoiceGroup ItemsSource="{Binding RecurrenceOptions}" Focusable="False" Margin="0,0,0,22"
                       AutomationProperties.Name="{loc:Loc Bills.Field.Recurrence}">
            <c:ChoiceGroup.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </c:ChoiceGroup.ItemsPanel>
            <c:ChoiceGroup.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource RadioButton.Choice}" GroupName="BillRecurrence" Margin="0,0,6,0"
                                 HorizontalContentAlignment="Center" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </c:ChoiceGroup.ItemTemplate>
        </c:ChoiceGroup>

        <TextBlock Text="{loc:Loc Bills.Field.FirstDue}" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding FirstDueDate, Converter={StaticResource DateOnlyToDateTime}}" Width="220" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="{loc:Loc Bills.Field.FirstDue}" Margin="0,0,0,4" />
        <TextBlock Text="{loc:Loc Bills.Field.FirstDue.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,18" />

        <TextBlock Text="{loc:Loc Transactions.Field.Category}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="{loc:Loc Transactions.Field.Category}"
                  IsTextSearchEnabled="True" Margin="0,0,0,22">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:CategoryOption}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc Bills.Field.Account}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutomationProperties.Name="{loc:Loc Bills.Field.Account}"
                  IsTextSearchEnabled="True" Margin="0,0,0,22">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:AccountOption}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc Transactions.Field.Notes}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="60" VerticalContentAlignment="Top" Padding="12,8" AutomationProperties.Name="{loc:Loc Transactions.Field.Notes}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
