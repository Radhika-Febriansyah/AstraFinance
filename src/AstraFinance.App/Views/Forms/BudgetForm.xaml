<UserControl x:Class="AstraFinance.App.Views.Forms.BudgetForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:BudgetFormViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Loc Transactions.Field.Category}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="{loc:Loc Transactions.Field.Category}"
                  IsTextSearchEnabled="True" Margin="0,0,0,22">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:CategoryOption}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc Budgets.Field.Amount}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" c:Assist.Placeholder="0"
                 AutomationProperties.Name="{loc:Loc Budgets.Field.Amount}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Budgets.Field.Start}" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding StartMonth, Converter={StaticResource DateOnlyToDateTime}}" Width="220" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="{loc:Loc Budgets.Field.Start}" Margin="0,0,0,4" />
        <TextBlock Text="{loc:Loc Budgets.Field.Start.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,18" />

        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCustomThreshold}" Content="{loc:Loc Budgets.Field.Threshold.Custom}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding UseCustomThreshold, Converter={StaticResource BoolToVisibility}}">
            <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="80" InputScope="Number" MaxLength="3"
                     AutomationProperties.Name="{loc:Loc Budgets.Field.Threshold}" />
            <TextBlock Text="%" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding DefaultThresholdHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,22" />

        <TextBlock Text="{loc:Loc Transactions.Field.Notes}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="60" VerticalContentAlignment="Top" Padding="12,8" AutomationProperties.Name="{loc:Loc Transactions.Field.Notes}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
