<UserControl x:Class="AstraFinance.App.Views.Forms.AccountEditorForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dlg:AccountEditorViewModel}">
    <StackPanel>
        <TextBlock Text="{loc:Loc Accounts.Field.Name}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                 c:Assist.Placeholder="{loc:Loc Accounts.Field.Name.Placeholder}"
                 AutomationProperties.Name="{loc:Loc Accounts.Field.Name}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Accounts.Field.Type}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{loc:Loc Accounts.Field.Type}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Accounts.Field.Opening}" Style="{StaticResource FieldLabel}" />
        <Grid Margin="0,0,0,22">
            <TextBox Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                     c:Assist.Placeholder="0" InputScope="Number"
                     AutomationProperties.Name="{loc:Loc Accounts.Field.Opening}"
                     Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OpeningBalanceDisplay}" Style="{StaticResource Text.BodyStrong}" />
                <TextBlock Text="{loc:Loc Accounts.Field.Opening.Locked}" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{loc:Loc Accounts.Field.Opening.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                   TextTrimming="None" Margin="0,-16,0,18"
                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

        <TextBlock Text="{loc:Loc Accounts.Field.Icon}" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding IconOptions}" SelectedItem="{Binding SelectedIcon}" Style="{StaticResource PickerList}"
                 ItemContainerStyle="{StaticResource IconPickerItem}" AutomationProperties.Name="{loc:Loc Accounts.Field.Icon}" Margin="0,0,0,14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <c:AstraIcon IconKey="{Binding}" Width="18" Height="18" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{loc:Loc Accounts.Field.Color}" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}" Style="{StaticResource PickerList}"
                 ItemContainerStyle="{StaticResource ColorPickerItem}" AutomationProperties.Name="{loc:Loc Accounts.Field.Color}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
