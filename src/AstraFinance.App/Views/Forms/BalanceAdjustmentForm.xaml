<UserControl x:Class="AstraFinance.App.Views.Forms.BalanceAdjustmentForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dlg:BalanceAdjustmentViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Loc Accounts.Adjust.Explanation}" Style="{StaticResource Text.Paragraph}" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,18">
            <Grid>
                <TextBlock Text="{Binding AccountName}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Loc Accounts.Adjust.Current}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CurrentBalanceText}" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{loc:Loc Accounts.Adjust.NewBalance}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding NewBalanceText, UpdateSourceTrigger=PropertyChanged}" InputScope="Number"
                 AutomationProperties.Name="{loc:Loc Accounts.Adjust.NewBalance}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource Text.Caption}" Margin="0,18,0,18" />

        <TextBlock Text="{loc:Loc Accounts.Adjust.Reason}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                 c:Assist.Placeholder="{loc:Loc Accounts.Adjust.Reason.Placeholder}"
                 AutomationProperties.Name="{loc:Loc Accounts.Adjust.Reason}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Accounts.Adjust.Date}" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}}" Width="200" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="{loc:Loc Accounts.Adjust.Date}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
