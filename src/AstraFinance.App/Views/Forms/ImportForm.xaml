<UserControl x:Class="AstraFinance.App.Views.Forms.ImportForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             xmlns:dlg="clr-namespace:AstraFinance.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:ImportFormViewModel}">
    <UserControl.Resources>
        <Style x:Key="MapCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,0,0,14" TextWrapping="Wrap">
            <Run Text="{loc:Loc Settings.Data.Import.Intro}" /><Run Text=" " /><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Text="{loc:Loc Settings.Data.Import.Account}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,14"
                  AutomationProperties.Name="{loc:Loc Settings.Data.Import.Account}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:AccountOption}">
                    <StackPanel Orientation="Horizontal">
                        <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc Settings.Data.Import.Columns}" Style="{StaticResource FieldLabel}" />
        <UniformGrid Columns="2">
            <StackPanel>
                <TextBlock Text="{loc:Loc Report.Column.Date}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding Columns}" SelectedItem="{Binding DateColumn}" AutomationProperties.Name="{loc:Loc Report.Column.Date}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Report.Column.Amount}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding Columns}" SelectedItem="{Binding AmountColumn}" AutomationProperties.Name="{loc:Loc Report.Column.Amount}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Report.Column.Description}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding OptionalColumns}" SelectedItem="{Binding DescriptionColumn}" AutomationProperties.Name="{loc:Loc Report.Column.Description}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Report.Column.Category}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding OptionalColumns}" SelectedItem="{Binding CategoryColumn}" AutomationProperties.Name="{loc:Loc Report.Column.Category}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Report.Column.Type}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding OptionalColumns}" SelectedItem="{Binding TypeColumn}" AutomationProperties.Name="{loc:Loc Report.Column.Type}" />
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="2" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings.Data.Import.DateFormat}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding DateStyleOptions}" SelectedItem="{Binding DateStyle}" AutomationProperties.Name="{loc:Loc Settings.Data.Import.DateFormat}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings.Data.Import.NumberFormat}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                <ComboBox Style="{StaticResource MapCombo}" ItemsSource="{Binding NumberStyleOptions}" SelectedItem="{Binding NumberStyle}" AutomationProperties.Name="{loc:Loc Settings.Data.Import.NumberFormat}" />
            </StackPanel>
        </UniformGrid>
        <TextBlock Text="{loc:Loc Settings.Data.Import.SignHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />

        <!-- Preview -->
        <Border CornerRadius="8" Background="{DynamicResource Brush.Surface.Raised}" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding PreviewRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:ImportPreviewRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Description}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding AmountText}" Style="{StaticResource Text.BodyStrong}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                        <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text="{Binding Message, Mode=OneWay, StringFormat='  ·  {0}'}" />
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Duplicate">
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding MoreRowsText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                           Visibility="{Binding MoreRowsText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeDuplicates}" Content="{loc:Loc Settings.Data.Import.IncludeDuplicates}" Margin="0,14,0,0" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
