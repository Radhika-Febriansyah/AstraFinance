<UserControl x:Class="AstraFinance.App.Views.Forms.AllocationForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:AstraFinance.App.Controls"
             xmlns:loc="clr-namespace:AstraFinance.App.Localization"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             xmlns:pages="clr-namespace:AstraFinance.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:AllocationFormViewModel}">
    <UserControl.Resources>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding GoalName}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Paragraph}" Margin="0,0,0,18" />

        <TextBlock Text="{loc:Loc Transactions.Field.Account}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutomationProperties.Name="{loc:Loc Transactions.Field.Account}" Margin="0,0,0,4">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:AllocationAccountOption}">
                    <Grid MinWidth="260">
                        <StackPanel Orientation="Horizontal">
                            <c:AstraIcon IconKey="{Binding IconKey}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Text.Caption}" Margin="0,0,0,18" />

        <TextBlock Text="{loc:Loc Transactions.Field.Amount}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" c:Assist.Placeholder="0"
                 FontSize="20" MinHeight="44" AutomationProperties.Name="{loc:Loc Transactions.Field.Amount}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Transactions.Field.Date}" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}}" Width="220" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="{loc:Loc Transactions.Field.Date}" Margin="0,0,0,22" />

        <TextBlock Text="{loc:Loc Goals.Field.Note}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="{loc:Loc Goals.Field.Note}" />

        <TextBlock Text="{Binding GeneralError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
