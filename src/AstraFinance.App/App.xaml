<Application x:Class="AstraFinance.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AstraFinance.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                ThemeService inserts the active color dictionary (Colors.Light/Dark.xaml) at index 0
                and the generated accent dictionary at index 1 during startup.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AstraFinance;component/Themes/Tokens.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Primitives.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Buttons.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Inputs.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Menus.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Lists.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/DatePicker.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/DataGrid.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Forms.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Cards.xaml" />
                <ResourceDictionary Source="/AstraFinance;component/Views/PageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />

            <Thickness x:Key="Padding.Page.Current">32,24,32,32</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
