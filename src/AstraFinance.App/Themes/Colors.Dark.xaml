<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Astra Finance — Dark theme palette (brand: Deep Navy #172554, Royal Blue #2563EB, White).
        Deep-navy background and surfaces, soft white text, cool gray secondary text.
        Accent brushes are supplied separately by ThemeService (see AccentPalette).
        Keys must match Colors.Light.xaml exactly (verified by unit test).
    -->
    <Color x:Key="Color.Background">#FF0B1229</Color>
    <Color x:Key="Color.Sidebar">#FF0F1B44</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="#FF0B1229" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF0F1B44" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF111C3A" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#FF162348" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#FF0E1733" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FF17244A" />

    <SolidColorBrush x:Key="Brush.Border" Color="#FF22305A" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF33447A" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF1B2850" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FFA8B4CC" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#FF8190AE" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF56658A" />
    <SolidColorBrush x:Key="Brush.Text.OnStrong" Color="#FF0B1229" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3050A1A" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF33447A" />
    <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="#FF4A5D96" />

    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="#FF22305A" />
    <SolidColorBrush x:Key="Brush.Tooltip.Text" Color="#FFF1F5F9" />

    <!-- Functional colors: green = income/success, red = expense/error, amber = attention, blue = information. -->
    <SolidColorBrush x:Key="Brush.Success" Color="#FF34D399" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#2634D399" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#26FBBF24" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#26F87171" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#FFFA8C8C" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Subtle" Color="#2660A5FA" />

    <!-- Brand sidebar: Deep Navy with a subtle blue gradient. -->
    <LinearGradientBrush x:Key="Brush.Sidebar.Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0F1B44" Offset="0" />
        <GradientStop Color="#FF13235A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="Brush.Sidebar.Text.Secondary" Color="#FFB4C3EA" />
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Selected" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Indicator" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.Sidebar.Divider" Color="#1FFFFFFF" />

    <!-- Hero statistic cards: restrained Deep Navy → Royal Blue gradient with white text. -->
    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF172554" Offset="0" />
        <GradientStop Color="#FF1D4ED8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Hero.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Hero.Text.Secondary" Color="#FFF0F4FE" />
    <SolidColorBrush x:Key="Brush.Hero.Border" Color="#26FFFFFF" />

    <!-- Elevation: popups, dialogs and floating cards. -->
    <DropShadowEffect x:Key="Effect.Shadow.Popup" Color="#000000" Opacity="0.50" BlurRadius="28" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="Effect.Shadow.Card" Color="#000000" Opacity="0.35" BlurRadius="14" ShadowDepth="2" Direction="270" />
</ResourceDictionary>
