<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Astra Finance — Dark theme palette.
        Charcoal background, subtle navy surfaces, soft white text, muted gray secondary text.
        Accent brushes are supplied separately by ThemeService (see AccentPalette).
    -->
    <Color x:Key="Color.Background">#FF15171C</Color>
    <Color x:Key="Color.Sidebar">#FF111318</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="#FF15171C" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF111318" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF1B2130" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#FF212839" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#FF171C27" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FF1E2433" />

    <SolidColorBrush x:Key="Brush.Border" Color="#FF2A3243" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF3A4458" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF242B3A" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFF1F1EE" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FFA0A7B5" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#FF737B8C" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF545B6A" />
    <SolidColorBrush x:Key="Brush.Text.OnStrong" Color="#FF15171C" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#99080A0F" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF3A4458" />
    <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="#FF4C5870" />

    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="#FF2A3243" />
    <SolidColorBrush x:Key="Brush.Tooltip.Text" Color="#FFF1F1EE" />

    <SolidColorBrush x:Key="Brush.Success" Color="#FF3DBE8B" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#263DBE8B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF2B54A" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#26F2B54A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF07272" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#26F07272" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#FFF48A8A" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF6AA6F2" />
    <SolidColorBrush x:Key="Brush.Info.Subtle" Color="#266AA6F2" />

    <!-- Restrained elevation: popups/dialogs only. -->
    <DropShadowEffect x:Key="Effect.Shadow.Popup" Color="#000000" Opacity="0.45" BlurRadius="24" ShadowDepth="6" Direction="270" />
    <DropShadowEffect x:Key="Effect.Shadow.Card" Color="#000000" Opacity="0.30" BlurRadius="12" ShadowDepth="1" Direction="270" />
</ResourceDictionary>
