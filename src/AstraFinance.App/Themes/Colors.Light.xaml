<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Astra Finance — Light theme palette (brand: Deep Navy #172554, Royal Blue #2563EB, White).
        White background, soft cool-gray surfaces, navy-charcoal text, muted gray secondary text.
        Keys must match Colors.Dark.xaml exactly (verified by unit test).
    -->
    <Color x:Key="Color.Background">#FFFFFFFF</Color>
    <!-- Sidebar and title bar are the Deep Navy brand chrome in both themes. -->
    <Color x:Key="Color.Sidebar">#FF172554</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF172554" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFF5F7FB" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#FFEEF1F7" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Border" Color="#FFE2E7F0" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FFC9D1DF" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFEBEFF5" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FF0F172A" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FF536079" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#FF64708A" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FFB4BCCB" />
    <SolidColorBrush x:Key="Brush.Text.OnStrong" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#0D172554" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#08172554" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#14172554" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#66172554" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FFC9D1DF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="#FFA6B1C4" />

    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="#FF172554" />
    <!-- Floating notification card: nearly opaque, so content behind shows through very slightly. -->
    <SolidColorBrush x:Key="Brush.Toast.Background" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="Brush.Tooltip.Text" Color="#FFF5F7FB" />

    <!-- Functional colors: green = income/success, red = expense/error, amber = attention, blue = information. -->
    <SolidColorBrush x:Key="Brush.Success" Color="#FF15803D" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#1F15803D" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFB45309" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#24F59E0B" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC62828" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#1FC62828" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#FFB01F1F" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.Info.Subtle" Color="#1F2563EB" />

    <!-- Brand sidebar: Deep Navy with a subtle blue gradient. -->
    <LinearGradientBrush x:Key="Brush.Sidebar.Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF172554" Offset="0" />
        <GradientStop Color="#FF1E3A8A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Text.Secondary" Color="#FFB4C3EA" />
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Selected" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar.Indicator" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.Sidebar.Divider" Color="#1FFFFFFF" />

    <!-- Hero statistic cards: restrained Deep Navy → Royal Blue gradient with white text. -->
    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF172554" Offset="0" />
        <GradientStop Color="#FF2563EB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Hero.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Hero.Text.Secondary" Color="#FFF0F4FE" />
    <SolidColorBrush x:Key="Brush.Hero.Border" Color="#00FFFFFF" />

    <!-- Elevation: popups, dialogs and floating cards (soft, navy-tinted). -->
    <DropShadowEffect x:Key="Effect.Shadow.Popup" Color="#172554" Opacity="0.16" BlurRadius="28" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="Effect.Shadow.Card" Color="#172554" Opacity="0.07" BlurRadius="14" ShadowDepth="2" Direction="270" />
</ResourceDictionary>
