<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- ============================================================
         Astra Finance design tokens (theme-independent).
         Colors live in Colors.Light.xaml / Colors.Dark.xaml and the
         accent dictionary generated by ThemeService.
         ============================================================ -->

    <!-- Typography -->
    <FontFamily x:Key="Font.Base">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <system:Double x:Key="FontSize.Caption">12</system:Double>
    <system:Double x:Key="FontSize.Body">14</system:Double>
    <system:Double x:Key="FontSize.Subtitle">16</system:Double>
    <system:Double x:Key="FontSize.Title">20</system:Double>
    <system:Double x:Key="FontSize.PageTitle">24</system:Double>
    <system:Double x:Key="FontSize.Display">32</system:Double>

    <!-- Corner radii (restrained) -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Spacing scale (4px grid) -->
    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">12</system:Double>
    <system:Double x:Key="Space.4">16</system:Double>
    <system:Double x:Key="Space.6">24</system:Double>
    <system:Double x:Key="Space.8">32</system:Double>

    <Thickness x:Key="Padding.Control">12,0,12,0</Thickness>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Padding.Page">32,24,32,32</Thickness>
    <Thickness x:Key="Padding.Page.Compact">16,16,16,24</Thickness>

    <!-- Sizes -->
    <system:Double x:Key="Size.Control.Height">36</system:Double>
    <system:Double x:Key="Size.Control.Height.Small">28</system:Double>
    <system:Double x:Key="Size.Icon">18</system:Double>
    <system:Double x:Key="Size.Icon.Small">16</system:Double>
    <system:Double x:Key="Size.Topbar.Height">64</system:Double>
    <system:Double x:Key="Size.Sidebar.Expanded">240</system:Double>
    <system:Double x:Key="Size.Sidebar.Collapsed">68</system:Double>

    <!-- Motion (subtle) -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.20</Duration>
    <QuadraticEase x:Key="Motion.Ease" EasingMode="EaseOut" />

    <!-- ============== Text styles ============== -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    </Style>

    <Style x:Key="Text.Paragraph" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
</ResourceDictionary>
