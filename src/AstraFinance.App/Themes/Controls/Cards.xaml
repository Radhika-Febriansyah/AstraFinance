<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AstraFinance.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AstraFinance;component/Themes/Tokens.xaml" />
        <ResourceDictionary Source="/AstraFinance;component/Themes/Controls/Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Page-level building blocks shared by the financial pages (Phase 4 of the 1.1 rebranding):
        interactive cards, hero statistic cards, tinted icon tiles, statistic text and toolbars.
    -->

    <!-- ============== Statistic text ============== -->
    <Style x:Key="Text.Stat.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}" />

    <Style x:Key="Text.Stat.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Margin" Value="0,10,0,2" />
    </Style>

    <Style x:Key="Text.Stat.Value.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <!-- ============== Icon tiles (rounded square with a tinted background) ============== -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent.Text}" />
    </Style>
    <Style x:Key="IconTile.Small" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style x:Key="IconTile.Success" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style x:Key="IconTile.Danger" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style x:Key="IconTile.Warning" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style x:Key="IconTile.Info" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
    </Style>
    <Style x:Key="IconTile.Neutral" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <!-- On a hero (gradient) card -->
    <Style x:Key="IconTile.OnHero" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Hero.Text}" />
    </Style>

    <!-- Icon inside a tile: inherits the tile's TextElement.Foreground. -->
    <Style x:Key="IconTile.Icon" TargetType="c:AstraIcon" BasedOn="{StaticResource {x:Type c:AstraIcon}}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <!-- ============== Interactive cards ============== -->
    <!-- Whole card is a button (e.g. navigates to its detail page). Hover lifts the surface slightly. -->
    <Style x:Key="Card.Button" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Style="{StaticResource Card}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                            <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Shadow.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hero statistic card as a button: Deep Navy → Royal Blue gradient with white text. -->
    <Style x:Key="Card.Hero.Button" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Hero.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Astra}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" Style="{StaticResource Card.Hero}" />
                        <Border x:Name="Overlay" CornerRadius="{StaticResource Radius.Card}" Background="Transparent" />
                        <ContentPresenter Margin="{StaticResource Padding.Card}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#14FFFFFF" />
                            <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Shadow.Card}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#1A000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============== Toolbars ============== -->
    <!-- Search / filter bar above lists and tables. -->
    <Style x:Key="Toolbar" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Section heading inside a card -->
    <Style x:Key="Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}" />
</ResourceDictionary>
